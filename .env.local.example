# Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
# El Redirect URI registrado debe coincidir EXACTAMENTE con AUTH_URL + /api/auth/callback/spotify.
# Spotify no acepta `localhost` en apps nuevas: usa 127.0.0.1.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm API (https://www.last.fm/api/account/create)
# Fuente principal de géneros: Spotify deprecó los suyos en febrero de 2026.
LASTFM_API_KEY=

# Auth.js — genera uno con: npx auth secret
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000

# Secreto del endpoint de captura (/api/cron/capture).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Zona horaria IANA para local_date y local_hour — p. ej. America/Lima,
# Europe/Madrid. Obligatoria.
#
# Cuidado: local_date y local_hour están GRABADOS en cada fila de `streams`.
# Cambiar esta variable no recalcula nada por sí sola; hay que hacerlo desde
# /musica/ajustes o las estadísticas quedarán descuadradas en silencio.
STATS_TZ=
